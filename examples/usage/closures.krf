; closures.krf —— 词法闭包与可变捕获（§8.5）
(require io write)
(define (make-counter)
  (let ((n 0))
    (fn ()
      (assign n (+ n 1))
      n)))
(define a (make-counter))
(define b (make-counter))
(a) (a) (a)
(b)
(print (list (a) (b)))   ; ⇒ (4 2)：a 计数 4、b 独立计数 2
(define (make-adder n)
  (fn (x) (+ x n)))
(define add5 (make-adder 5))
(add5 37)
