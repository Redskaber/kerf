; macros.krf —— 卫生宏（syntax-rules + 省略号 + 引入标识符重命名）
(require io write)
(define-syntax my-or
  (syntax-rules ()
    ((my-or) false)
    ((my-or a) a)
    ((my-or a rest ...) (if a true (my-or rest ...)))))
(define-syntax swap!
  (syntax-rules ()
    ((swap! x y)
     (let ((tmp x))
       (assign x y)
       (assign y tmp)))))
(define p 1)
(define q 2)
(swap! p q)
(print (list p q))       ; ⇒ (2 1)
(my-or false false 42)
