; compiler.krf — kerf 自举 Compiler（Stage 2 批次 I / I1 前段：基础核心形式）
;
; 本文件以 kerf 源码实现编译器段（compile.rs 798 行的语义镜像——八臂：
; Literal/VarRef/If/Begin/SetBang/Define/App/Lambda + 作用域解析机 +
; 闭包捕获 + 跳转回填 + 常量池 intern + 尾位穿线 TCO），在 Stage 0 VM
; 上运行（07-bootstrap §3.2 混合期构成：Compiler 属新语言子集）。
; 行为与种子实现（kerf-compiler/compile.rs，Rust）的 parity 判据 =
; BcProgram::bytecode_equal（全结构含 debug_spans——INC5），由
; tests/v0/stage2/plan/bootstrap_compiler_tests.rs 验收（i1-incision-
; migration-design §5 门 A 基础组）。生产切换（CompilerKind）属 42-d
; ——本段当前为 parity 影子路径（种子仍是生产编译器）。
;
; 契约（与 kerf-driver/src/bootstrap_compiler.rs 桥对接）：
; - 入口 (lexc-compile-program nodes)：
;     nodes = core 节点列表（输入格式，见下）
;     正常 → ('prog (proto 节点...) (const 节点...) (全局名 str 列表))
;     错误 → ('err 消息 起始字节 结束字节)
; - 输入 core 节点 = (tag s e exp ...)（tag 为 quote 符号值；s/e = Span
;     起止字节；exp = 展开代次——镜像 bootstrap_expander.rs 输出格式）：
;     ('literal s e x 字面量值)——字面量值为消歧标记形态（Str/Symbol/Float
;     在 VM 值面无谓词区分，桥侧定型标记——INC4 实现期修订，见
;     i1-incision-migration-design.md INC4 注记）：
;       ('int v) ('float v) ('str s) ('true) ('false) ('nil)
;       ('sym 名字str) ('pair 左 右)
;     ('var s e x 名字str 作用域int列表)
;     ('apply s e x 函数 参数...) ('if s e x 条件 真分支 假分支)
;     ('fn s e x (名字str...) (作用域int列表...) 体)
;     ('assign s e x 名字str 作用域 值) ('define s e x 名字str 值)
;     ('do s e x 项...)
;     ('module s e x 名 (导入...) (导出...) 体...) / ('require s e x 能力str...)
;     —— 两臂 42-c 已迁：module 体 inline（每项恒非尾位 + 中间值
;     Pop——span = 项自身；空体 PushNil——span = module 自身；首原型
;     名覆写 '<main>' 值等价（Rust pm.name = Symbol(u32::MAX-1) 与
;     proto 0 创建/回写值恒等——无操作注记）；require = PushNil
;     （r8 能力声明零字节码语义——R9 在 driver 前端完成）
;     ('perform s e x 效应节点) / ('handle s e x tagstr 载荷名
;     载荷作用域 恢复名 恢复作用域 handler节点 body节点)
;     —— 两臂 r25/42-f 已迁（三原型帧编排镜像 compile_handle：
;     T 惰性单例（CC-TRAMPOLINE，span 三元组恒 (0 0 0)——与 Rust
;     Span::dummy 对齐）→ H（params = [载荷名 恢复名]）→ B（body
;     thunk）→ INSTALL_HANDLER 原子发射；tag 经 SymLit 常量 intern）
; - 输出 proto 节点 = ('proto 名形 (参数名...) nlocals (捕获名...)
;     (捕获源...) (指令...) (span 三元组...) 自由变量)：
;     名形 = ('main)（Symbol(u32::MAX-1) 魔法标记）| ('anon)
;     （Symbol(u32::MAX-2)）| ('name 名字str)（首个形参名）
;     捕获源 = ('local i) | ('captured i)
;     指令 = ('op 码int 操作数...)——码表见下方 OP-* 定义（opcode.rs
;     声明序 0..=42；Closure 双操作数 proto/n_captures；INSTALL_HANDLER
;     四操作数 handler/body/tag/trampoline——r25/42-f）
;     span 三元组 = (起始 结束 代次)——file_id 由桥侧统一注入
;     （bytecode_equal 判据含 expansion_id，故三元组非对——INC4 注记）
; - 输出 const 节点 = ('const 类型tag 值)：
;     ('const 'int v) ('const 'float v) ('const 'str s) ('const 'bool b)
;     ('const 'nil nil) ('const 'sym 名字str)（全局引用名）
;     ('const 'symlit 名字str)（quote 符号字面量——TD-002 口径）
; - 确定性纪律（§7——fixpoint 先决）：入口全量复位（镜像
;   CompileCtxt::new 的每次调用新上下文语义）；常量池/全局索引 =
;   首次插入序（关联列表——镜像 Rust intern 查后插的确定性；krf 无
;   HashMap 天然满足禁哈希序）；符号一律 str 携带（桥回 intern）。
; - 全局符号卫生回退（B10）：LOAD_GLOBAL 未命中的 $hyg$N 剥离回退是
;   VM/driver 运行期行为（resolve_hygiene_fallbacks）——本编译段按
;   原名发射 LoadGlobal，与种子同口径（编译期零感知）。

; ===== 序章：高阶函数（expander.krf 同款）=====

(define (map f lst)
  (if (is-nil lst)
      nil
      (cons (f (head lst)) (map f (tail lst)))))

(define (filter pred lst)
  (if (is-nil lst)
      nil
      (if (pred (head lst))
          (cons (head lst) (filter pred (tail lst)))
          (filter pred (tail lst)))))

(define (foldl f init lst)
  (if (is-nil lst)
      init
      (foldl f (f init (head lst)) (tail lst))))

; ===== 列表访问 =====

(define (first x) (head x))
(define (second x) (head (tail x)))
(define (third x) (head (tail (tail x))))
(define (fourth x) (head (tail (tail (tail x)))))
(define (fifth x) (head (tail (tail (tail (tail x))))))
(define (sixth x) (head (tail (tail (tail (tail (tail x)))))))
(define (seventh x) (head (tail (tail (tail (tail (tail (tail x))))))))
(define (eighth x) (head (tail (tail (tail (tail (tail (tail (tail x)))))))))

; 节点固定字段：tag s e exp；fields = 其后内容（四头字段协议——core
; 节点形态，与 expander.krf 输出一致）
(define (node-tag n) (head n))
(define (node-s n) (second n))
(define (node-e n) (third n))
(define (node-exp n) (fourth n))
(define (node-fields n) (tail (tail (tail (tail n)))))

; 去尾（作用域帧弹出——帧表按出现序）
(define (drop-last lst) (reverse (tail (reverse lst))))

; member 命中返回子表 / 未命中返回 false——contains? 归一为布尔
; （truthy 语义仅 Bool，不能直接以 member 结果作条件）
(define (contains? x lst)
  (not (is-bool (member x lst))))

; assoc 命中返回键值对 / 未命中返回 false——idx-lookup 未命中归一 nil
(define (idx-lookup key al)
  (let ((r (assoc key al)))
    (if (is-bool r) nil r)))

; 错误值构造与判别（契约：('err 消息 起始 结束)）
(define (cerr msg s e) (list 'err msg s e))
(define (err? v)
  (and (is-pair v) (eq (head v) 'err)))

; ===== 操作码常量（opcode.rs 声明序 0..=42——桥侧同表映射 Op；
; r25/42-f：41/42 效应两指令（INSTALL_HANDLER 四操作数 / PERFORM）=====

(define OP-PUSH-CONST 0)      ; (op 0 k)
(define OP-PUSH-NIL 1)
(define OP-PUSH-TRUE 2)
(define OP-PUSH-FALSE 3)
(define OP-POP 4)
(define OP-DUP 5)
(define OP-SWAP 6)
(define OP-LOAD-LOCAL 7)      ; (op 7 i)
(define OP-STORE-LOCAL 8)
(define OP-LOAD-GLOBAL 9)     ; (op 9 gi)
(define OP-STORE-GLOBAL 10)
(define OP-DEFINE-GLOBAL 11)
(define OP-LOAD-CAPTURED 12)
(define OP-STORE-CAPTURED 13)
(define OP-JUMP 14)           ; (op 14 t)
(define OP-JUMP-IF-FALSE 15)
(define OP-CLOSURE 16)        ; (op 16 proto n_captures)
(define OP-CALL 17)           ; (op 17 n)
(define OP-TAIL-CALL 18)      ; TCO 尾位（TD-022/H2——B9 必含面）
(define OP-RET 19)
(define OP-ADD 20)
(define OP-SUB 21)
(define OP-MUL 22)
(define OP-DIV 23)
(define OP-MOD 24)
(define OP-NUM-LT 25)
(define OP-NUM-GT 26)
(define OP-NUM-LE 27)
(define OP-NUM-GE 28)
(define OP-NUM-EQ 29)
(define OP-EQ 30)
(define OP-NOT 31)
(define OP-MAKE-PAIR 32)
(define OP-CAR 33)
(define OP-CDR 34)
(define OP-IS-NULL 35)
(define OP-IS-PAIR 36)
(define OP-IS-INT 37)
(define OP-IS-BOOL 38)
(define OP-IS-PROCEDURE 39)
(define OP-HALT 40)
(define OP-INSTALL-HANDLER 41) ; (op 41 handler body tag trampoline)——r25/42-f
(define OP-PERFORM 42)          ; 效应上抛（R10）
(define OP-CALL-EXTERNAL 43)    ; (op 43 symbol n_args)——r30/48-d FFI（ffi-ownership-model §2/§8）
(define OP-ALLOC-EXTERNAL 44)   ; (op 44 size)——外部域分配（不经过 GC）
(define OP-FREE-EXTERNAL 45)    ; 令牌消费释放——编译臂不发射（语言面 Stage 3）

; 跳转占位操作数（Rust u32::MAX——回填前哨兵）
(define PATCH-SENTINEL 4294967295)

; ===== 编译状态（镜像 CompileCtxt——每次入口复位）=====
; CC-SCOPES   = 帧列表（帧 = (局部绑定 . 捕获绑定)——按出现序，帧 0 = main）
; CC-PROTOS   = 原型记录列表（rust 序追加；记录 = (名形 参数 nlocals
;               捕获名 捕获源 code-rev spans-rev 自由变量)）
; CC-CUR      = 当前发射原型索引；当前窗口的指令/span 在 CC-CODE-REV /
;               CC-SPANS-REV（逆序累积——发射 O(1)，fn 切换时回写）
; CC-CONSTS   = ('const tag 值) 节点列表（插入序 = 池索引）
; CC-GLOBAL-IDX = (名字str . 池索引) 关联列表（intern_global 快查）
; CC-GLOBAL-REFS = 全局名 str 列表（首次插入序）
; CC-PATCHES  = (原型 . pc) 待回填队列（§19.3 不变式 2：完成时清空）

(define CC-SCOPES nil)
(define CC-PROTOS nil)
(define CC-CUR 0)
(define CC-CODE-REV nil)
(define CC-SPANS-REV nil)
(define CC-CONSTS nil)
(define CC-GLOBAL-IDX nil)
(define CC-GLOBAL-REFS nil)
(define CC-PATCHES nil)
; CC-TRAMPOLINE = trampoline 哨兵原型索引（r25/42-f 惰性单例——nil =
;               未生成；镜像 Rust CompileCtxt.trampoline）
(define CC-TRAMPOLINE nil)
; 自由变量分析暂存（fn 编译期）
(define CC-BOUND nil)
(define CC-FREE nil)
(define CC-CAP-NAMES nil)
(define CC-CAP-BINDINGS nil)
(define CC-CAP-SRCS nil)
(define CC-FREEVARS nil)

; ===== 发射原语（镜像 emit/here/emit_jump/patch_jump）=====

; 当前原型指令数（here()——最终序位置 = 下一条指令的 pc）
(define (here) (length CC-CODE-REV))

; 发射一条指令 + span（debug_spans 与 code 逐 pc 对齐——§19.3 不变式 3）
(define (emit! opnode s e x)
  (do
    (assign CC-CODE-REV (cons opnode CC-CODE-REV))
    (assign CC-SPANS-REV (cons (list s e x) CC-SPANS-REV))))

; 发射占位跳转并登记回填（返回 pc）
(define (emit-jump opcode s e x)
  (let ((pc (here)))
    (do
      (emit! (list 'op opcode PATCH-SENTINEL) s e x)
      (assign CC-PATCHES (cons (cons CC-CUR pc) CC-PATCHES))
      pc)))

; 回填跳转目标（逆序列表中最终位 pc ↔ 逆序位 = 长度-1-pc）
(define (patch-jump pc)
  (let ((target (here)))
    (do
      (assign CC-CODE-REV (patch-code CC-CODE-REV (- target 1 pc) target))
      (assign CC-PATCHES (remove-patch CC-PATCHES CC-CUR pc))
      target)))

; 替换逆序码表中第 k 位指令的目标操作数（Jump/JumpIfFalse 恰一操作数）
(define (patch-code lst k target)
  (if (= k 0)
      (cons (list 'op (second (head lst)) target) (tail lst))
      (cons (head lst) (patch-code (tail lst) (- k 1) target))))

; 从回填队列移除匹配 (原型 pc) 项
(define (remove-patch patches p c)
  (if (is-nil patches)
      nil
      (let ((ent (head patches)))
        (if (and (= (head ent) p) (= (tail ent) c))
            (remove-patch (tail patches) p c)
            (cons ent (remove-patch (tail patches) p c))))))

; 原型记录按索引替换（窗口切换回写）
(define (proto-set-at! idx rec)
  (assign CC-PROTOS (proto-set-loop CC-PROTOS idx rec 0)))

(define (proto-set-loop lst idx rec k)
  (if (= k idx)
      (cons rec (tail lst))
      (cons (head lst) (proto-set-loop (tail lst) idx rec (+ k 1)))))

; ===== 常量池（镜像 ConstPool::intern——按值去重，首次插入序即索引）=====

; 结构相等（eq 对序对是引用相等——const 节点需逐字段递归比较；
; Float 按 f64 == 语义镜像 Rust HashMap 的 Hash+Eq 去重行为：
; +0.0/-0.0 去重合一、NaN 永不去重）
(define (const-eq? a b)
  (if (eq (second a) (second b))
      (let ((ta (third a)) (tb (third b)))
        (cond ((eq (second a) 'int) (eq ta tb))
              ((eq (second a) 'float) (eq ta tb))
              ((eq (second a) 'str) (eq ta tb))
              ((eq (second a) 'sym) (eq ta tb))
              ((eq (second a) 'symlit) (eq ta tb))
              ((eq (second a) 'bool) (eq ta tb))
              ; 'nil 常量形态永不构造（Bool/Nil 直发指令不进池——
              ; 种子同口径）；nil 字面量标记在 kerf 中非符号，此处不可比
              (else false)))
      false))

(define (const-index-of cnode consts i)
  (if (is-nil consts)
      nil
      (if (const-eq? cnode (head consts))
          i
          (const-index-of cnode (tail consts) (+ i 1)))))

(define (intern-const cnode)
  (let ((idx (const-index-of cnode CC-CONSTS 0)))
    (if (is-nil idx)
        (let ((i (length CC-CONSTS)))
          (do
            (assign CC-CONSTS (append CC-CONSTS (list cnode)))
            i))
        idx)))

; ===== 全局引用登记（镜像 intern_global——常量池索引 + 去重登记）=====

(define (intern-global namestr)
  (let ((hit (idx-lookup namestr CC-GLOBAL-IDX)))
    (if (is-nil hit)
        (let ((i (intern-const (list 'const 'sym namestr))))
          (do
            (assign CC-GLOBAL-REFS (append CC-GLOBAL-REFS (list namestr)))
            (assign CC-GLOBAL-IDX (cons (cons namestr i) CC-GLOBAL-IDX))
            i))
        (tail hit))))

; ===== 作用域解析机（镜像 match_bindings + resolve_var——TD-004/r13）=====

; 帧内子集匹配：同名且 binder.scopes ⊆ ref_scopes 中取 max-cardinality
; （并列先注册优先——严格大于才替换）；返回 (槽位 . 绑定作用域集) 或 nil
(define (match-bindings bindings name ref-scopes)
  (mb-loop bindings name ref-scopes 0 nil 0))

(define (mb-loop bindings name ref-scopes i best best-rank)
  (if (is-nil bindings)
      best
      (let ((b (head bindings)))
        (if (and (eq (head b) name) (scope-subset? (tail b) ref-scopes))
            (let ((rank (length (tail b))))
              (if (or (is-nil best) (> rank best-rank))
                  (mb-loop (tail bindings) name ref-scopes (+ i 1)
                           (cons i (tail b)) rank)
                  (mb-loop (tail bindings) name ref-scopes (+ i 1)
                           best best-rank)))
            (mb-loop (tail bindings) name ref-scopes (+ i 1)
                     best best-rank)))))

; 作用域集子集判定（binder ⊆ ref——逐元素成员检查）
(define (scope-subset? sub ref)
  (if (is-nil sub)
      true
      (if (contains? (head sub) ref)
          (scope-subset? (tail sub) ref)
          false)))

; 帧栈自顶（内层）向下解析；帧 0 仅局部（main 原型帧不构成闭包语义）；
; 其余帧局部先于捕获；首个含子集匹配的帧胜出；无候选 → 全局。
; 返回 ('local 槽位 绑定作用域集) / ('captured 槽位 绑定作用域集) /
; ('global nil)
(define (resolve-var name ref-scopes)
  ; 逆序传入：首 = 最内层帧 = 索引 fi（镜像 Rust .rev() 自顶向下）
  (rv-loop (reverse CC-SCOPES) name ref-scopes
           (- (length CC-SCOPES) 1)))

(define (rv-loop frames name ref-scopes fi)
  (if (is-nil frames)
      (list 'global nil)
      (let ((frame (head frames)))
        (if (= fi 0)
            (let ((m (match-bindings (head frame) name ref-scopes)))
              (if (is-nil m)
                  (rv-loop (tail frames) name ref-scopes (- fi 1))
                  (list 'local (head m) (tail m))))
            (let ((ml (match-bindings (head frame) name ref-scopes)))
              (if (is-nil ml)
                  (let ((mc (match-bindings (tail frame) name ref-scopes)))
                    (if (is-nil mc)
                        (rv-loop (tail frames) name ref-scopes (- fi 1))
                        (list 'captured (head mc) (tail mc))))
                  (list 'local (head ml) (tail ml))))))))

; ===== 自由变量出现（镜像 free_var_occurrences——绑定屏蔽 + letrec* 序）=====
; CC-BOUND = LIFO 列表（cons 头 = 最近绑定 = Rust Vec 尾）；CC-FREE =
; 逆序累积（消费时 reverse = 遍历序）。
; 语义镜像注记：Lambda 形参注入「新名才入栈」+ 弹出数恒为形参计数
; （Rust shadowed 计数口径原样镜像——同名形参遮蔽外层绑定时的弹出
; 行为与种子逐位一致，含其自由变量口径的既有行为）。

(define (fvo-bound-add! namestr)
  (if (contains? namestr CC-BOUND)
      nil
      (assign CC-BOUND (cons namestr CC-BOUND))))

(define (fvo-pop! n)
  (if (= n 0)
      nil
      (do
        (assign CC-BOUND (tail CC-BOUND))
        (fvo-pop! (- n 1)))))

(define (fvo-has-name? free namestr)
  (if (is-nil free)
      false
      (if (eq (head (head free)) namestr)
          true
          (fvo-has-name? (tail free) namestr))))

(define (fvo-push-free! namestr scopes)
  (if (and (not (contains? namestr CC-BOUND))
           (not (fvo-has-name? CC-FREE namestr)))
      (assign CC-FREE (cons (cons namestr scopes) CC-FREE))
      nil))

(define (fvo-node node)
  (let ((tag (symbol-to-string (node-tag node)))
        (fields (node-fields node)))
    (cond
      ((eq tag "var")
       (fvo-push-free! (first fields) (second fields)))
      ((eq tag "literal") nil)
      ((eq tag "fn")
       (let ((shadowed (length (first fields))))
         (do
           (fvo-params! (first fields))
           (fvo-node (third fields))
           (fvo-pop! shadowed))))
      ((eq tag "apply")
       (do
         (fvo-node (first fields))
         (fvo-seq (tail fields))))
      ((eq tag "if")
       (do
         (fvo-node (first fields))
         (fvo-node (second fields))
         (fvo-node (third fields))))
      ((eq tag "assign")
       (do
         (fvo-push-free! (first fields) (second fields))
         (fvo-node (third fields))))
      ((eq tag "define")
       (do
         (fvo-node (second fields))
         (fvo-bound-add! (first fields))))
      ((eq tag "do")
       (fvo-seq fields))
      ((eq tag "require") nil)
      ((eq tag "module")
       (fvo-seq (tail (tail (tail fields)))))
      ; r25/42-f 效应两臂（镜像 Rust free_var_occurrences）：perform
      ; 效应子树遍历；handle 两绑定器屏蔽 + handler/body 遍历（tag
      ; 为符号字面量非变量引用；fields 序 = tagstr pv pv-scopes rv
      ; rv-scopes handler body）
      ((eq tag "perform")
       (fvo-node (first fields)))
      ((eq tag "handle")
       (do
         (fvo-bound-add! (second fields))
         (fvo-bound-add! (fourth fields))
         (fvo-node (sixth fields))
         (fvo-node (seventh fields))
         (fvo-pop! 2)))
      (else nil))))

(define (fvo-params! params)
  (if (is-nil params)
      nil
      (do
        (fvo-bound-add! (head params))
        (fvo-params! (tail params)))))

(define (fvo-seq items)
  (if (is-nil items)
      nil
      (do
        (fvo-node (head items))
        (fvo-seq (tail items)))))

; ===== Lambda 编译（镜像 compile_lambda——闭包捕获转换 §8.5/§19.3）=====

; 捕获解析：遍历自由变量（遍历序），Local/Captured → 捕获槽（携带
; 命中绑定的绑定作用域集）；Global → 原型内全局引用（零捕获）。
; 自由变量总表（含全局引用名）恒记录。
(define (capture-resolve-loop free)
  (if (is-nil free)
      nil
      (let ((nm (head (head free)))
            (sc (tail (head free))))
        (do
          (assign CC-FREEVARS (cons nm CC-FREEVARS))
          (let ((r (resolve-var nm sc)))
            (do
              (if (eq (head r) 'local)
                  (do
                    (assign CC-CAP-NAMES (cons nm CC-CAP-NAMES))
                    (assign CC-CAP-BINDINGS
                      (cons (cons nm (third r)) CC-CAP-BINDINGS))
                    (assign CC-CAP-SRCS
                      (cons (list 'local (second r)) CC-CAP-SRCS)))
                  nil)
              (if (eq (head r) 'captured)
                  (do
                    (assign CC-CAP-NAMES (cons nm CC-CAP-NAMES))
                    (assign CC-CAP-BINDINGS
                      (cons (cons nm (third r)) CC-CAP-BINDINGS))
                    (assign CC-CAP-SRCS
                      (cons (list 'captured (second r)) CC-CAP-SRCS)))
                  nil)
              (capture-resolve-loop (tail free))))))))

; 形参绑定（绑定作用域集 = param_scopes[i]，缺失容错为空集——镜像
; param_scopes.get(i).cloned().unwrap_or_default()）
(define (param-bindings paramstrs paramscopes)
  (pb-loop paramstrs paramscopes 0))

(define (pb-loop paramstrs paramscopes i)
  (if (is-nil paramstrs)
      nil
      (cons (cons (head paramstrs)
                  (if (< i (length paramscopes))
                      (nth-or-nil paramscopes i)
                      nil))
            (pb-loop (tail paramstrs) paramscopes (+ i 1)))))

(define (nth-or-nil lst k)
  (if (= k 0)
      (head lst)
      (nth-or-nil (tail lst) (- k 1))))

; 原型名形：首个形参名 / 无参匿名标记
(define (proto-name-form paramstrs)
  (if (is-nil paramstrs)
      (list 'anon)
      (list 'name (head paramstrs))))

(define (compile-fn fields s e x)
  (let ((paramstrs (first fields))
        (paramscopes (second fields))
        (body (third fields)))
    (do
      ; 1. 自由变量出现（bound 起点 = 形参——LIFO 形态镜像 Vec 尾）
      (assign CC-BOUND (params->bound paramstrs nil))
      (assign CC-FREE nil)
      (fvo-node body)
      ; 2. 捕获解析（对当前作用域栈——新帧尚未压入）
      (assign CC-CAP-NAMES nil)
      (assign CC-CAP-BINDINGS nil)
      (assign CC-CAP-SRCS nil)
      (assign CC-FREEVARS nil)
      (capture-resolve-loop (reverse CC-FREE))
      (let ((cap-names (reverse CC-CAP-NAMES))
            (cap-binds (reverse CC-CAP-BINDINGS))
            (cap-srcs (reverse CC-CAP-SRCS))
            (freevars (reverse CC-FREEVARS)))
        (let ((proto-idx (length CC-PROTOS)))
          (do
            ; 3. 新原型（捕获描述符随原型冻结；code/spans 空）
            (assign CC-PROTOS
              (append CC-PROTOS
                (list (list (proto-name-form paramstrs)
                            paramstrs
                            (length paramstrs)
                            cap-names cap-srcs nil nil freevars))))
            ; 4. 新作用域帧（形参绑定 + 捕获绑定）
            (assign CC-SCOPES
              (append CC-SCOPES
                (list (cons (param-bindings paramstrs paramscopes)
                            cap-binds))))
            ; 5. 体编译（尾位 = true——TCO；窗口切换）
            (let ((enc-cur CC-CUR)
                  (enc-code CC-CODE-REV)
                  (enc-spans CC-SPANS-REV))
              (do
                (assign CC-CUR proto-idx)
                (assign CC-CODE-REV nil)
                (assign CC-SPANS-REV nil)
                (let ((r (compile-expr body true)))
                  (if (err? r)
                      r
                      (do
                        ; 尾部 RET（span = 体的 Span）
                        (emit! (list 'op OP-RET)
                               (node-s body) (node-e body) (node-exp body))
                        ; 6. 回写新原型 code/spans + 弹帧 + 还原窗口
                        (proto-set-at! proto-idx
                          (list (proto-name-form paramstrs)
                                paramstrs
                                (length paramstrs)
                                cap-names cap-srcs
                                CC-CODE-REV CC-SPANS-REV
                                freevars))
                        (assign CC-SCOPES (drop-last CC-SCOPES))
                        (assign CC-CUR enc-cur)
                        (assign CC-CODE-REV enc-code)
                        (assign CC-SPANS-REV enc-spans)
                        ; 7. 外围原型发射 CLOSURE（span = fn 的 Span）
                        (emit! (list 'op OP-CLOSURE proto-idx
                                    (length cap-names))
                               s e x)
                        nil)))))))))))

; 形参表 → LIFO 绑定列表（(pn ... p1 p0)——镜像 params.to_vec() 的
; Vec 尾部 LIFO 语义）
(define (params->bound params acc)
  (if (is-nil params)
      acc
      (params->bound (tail params) (cons (head params) acc))))

; ===== 表达式编译（镜像 compile_expr——八臂；栈平衡不变式 1）=====

(define (compile-expr node tail-pos)
  (let ((tag (symbol-to-string (node-tag node)))
        (s (node-s node))
        (e (node-e node))
        (x (node-exp node))
        (fields (node-fields node)))
    (cond
      ; ---- Literal（含引号点对递归——先 head 后 tail-pos 压栈对齐 MAKE_PAIR）----
      ((eq tag "literal") (compile-lit (first fields) s e x))
      ; ---- VarRef（解析 → LoadLocal/LoadCaptured/LoadGlobal）----
      ((eq tag "var") (compile-var (first fields) (second fields) s e x))
      ; ---- Lambda ----
      ((eq tag "fn") (compile-fn fields s e x))
      ; ---- App（求值顺序契约：被调函数先，参数从左到右；尾位 TailCall）----
      ((eq tag "apply")
       (let ((rf (compile-expr (first fields) false)))
         (if (err? rf)
             rf
             (compile-app-args (tail fields) (- (length fields) 1)
                               s e x tail-pos))))
      ; ---- If（跳转回填：j_false → then → j_end → patch j_false →
      ;        else → patch j_end；两臂继承尾位）----
      ((eq tag "if")
       (let ((rc (compile-expr (first fields) false)))
         (if (err? rc)
             rc
             (let ((jf (emit-jump OP-JUMP-IF-FALSE s e x)))
               (let ((rt (compile-expr (second fields) tail-pos)))
                 (if (err? rt)
                     rt
                     (let ((je (emit-jump OP-JUMP s e x)))
                       (do
                         (patch-jump jf)
                         (let ((re (compile-expr (third fields) tail-pos)))
                           (if (err? re)
                               re
                               (do
                                 (patch-jump je)
                                 nil)))))))))))
      ; ---- Set!（值 → DUP → 存储；目标解析与 VarRef 同一口径）----
      ((eq tag "assign")
       (let ((rv (compile-expr (third fields) false)))
         (if (err? rv)
             rv
             (do
               (emit! (list 'op OP-DUP) s e x)
               (let ((r (resolve-var (first fields) (second fields))))
                 (cond
                   ((eq (head r) 'local)
                    (emit! (list 'op OP-STORE-LOCAL (second r)) s e x))
                   ((eq (head r) 'captured)
                    (emit! (list 'op OP-STORE-CAPTURED (second r)) s e x))
                   (else
                    (emit! (list 'op OP-STORE-GLOBAL
                                 (intern-global (first fields)))
                           s e x))))))))
      ; ---- Define（仅入口原型：值 → DUP → DefineGlobal；函数体内
      ;        结构化拒绝——D1 全局泄漏防护，两路径同报）----
      ((eq tag "define")
       (if (not (= CC-CUR 0))
           (cerr "define 仅允许出现在顶层或函数体头部（do/表达式位置包裹的 define 不合法——嵌套 define 请置于体头部）"
                 s e)
           (let ((rv (compile-expr (second fields) false)))
             (if (err? rv)
                 rv
                 (do
                   (emit! (list 'op OP-DUP) s e x)
                   (emit! (list 'op OP-DEFINE-GLOBAL
                                (intern-global (first fields)))
                          s e x))))))
      ; ---- Begin（末项继承尾位——do 尾调用 = 尾调用；中间值弹出
      ;        span = 项自身 Span）----
      ((eq tag "do")
       (if (is-nil fields)
           (emit! (list 'op OP-PUSH-NIL) s e x)
           (compile-begin-seq fields 0 (length fields) tail-pos)))
      ; ---- Module（Stage 0 单模块语义：体 inline——逐项非尾位编译 +
      ;        中间值 Pop（span = 项自身 Span）；空体 PushNil（span =
      ;        module 自身 Span）；首原型名覆写 '<main>' 值等价无操作
      ;        注记——镜像 compile.rs:416 逐语义）----
      ((eq tag "module")
       (compile-module-body (tail (tail (tail fields))) s e x))
      ; ---- Require（r8 能力声明：求值恒 nil（零副作用）——PushNil
      ;        保持顶层「每形式一值」栈不变式（与 eval 路径 Ok(Nil)
      ;        一致，T1 双路径口径；权限验证已在 driver 前端 R9/E0006
      ;        完成——编译段零感知，与种子同口径）----
      ((eq tag "require")
       (emit! (list 'op OP-PUSH-NIL) s e x))
      ; ---- Perform（r25/42-f——R10：效应值先求值 → PERFORM；恒非尾
      ;        位：控制转移后未恢复则本表达式永不完成）----
      ((eq tag "perform")
       (let ((rf (compile-expr (first fields) false)))
         (if (err? rf)
             rf
             (do
               (emit! (list 'op OP-PERFORM) s e x)
               nil))))
      ; ---- Handle（r25/42-f——D6 三原型帧编排：T 惰性 → H → B →
      ;        INSTALL_HANDLER 原子发射（fields 序 = tagstr pv
      ;        pv-scopes rv rv-scopes handler body））----
      ((eq tag "handle")
       (compile-handle fields s e x))
      (else
       (cerr (string-append "未知 core 节点种类：" tag) s e)))))

(define (compile-app-args args argc s e x tail-pos)
  (if (is-nil args)
      (emit! (list 'op (if tail-pos OP-TAIL-CALL OP-CALL) argc) s e x)
      (let ((r (compile-expr (head args) false)))
        (if (err? r)
            r
            (compile-app-args (tail args) argc s e x tail-pos)))))

(define (compile-begin-seq items idx total tail-pos)
  (if (is-nil items)
      nil
      (let ((r (compile-expr (head items)
                             (and tail-pos (= (+ idx 1) total)))))
        (if (err? r)
            r
            (if (< (+ idx 1) total)
                (do
                  (emit! (list 'op OP-POP)
                         (node-s (head items)) (node-e (head items))
                         (node-exp (head items)))
                  (compile-begin-seq (tail items) (+ idx 1) total tail-pos))
                (compile-begin-seq (tail items) (+ idx 1) total tail-pos))))))

; module 体 inline（镜像 CoreExpr::Module 臂——逐项恒 tail=false 编译
; （区别于 do 末项继承尾位：module 项不构成尾位——TCO 不参与）+
; 中间值 Pop（span = 项自身 Span）；空体 PushNil（span = module Span））
(define (compile-module-body items s e x)
  (if (is-nil items)
      (emit! (list 'op OP-PUSH-NIL) s e x)
      (compile-module-seq items 0 (length items))))

(define (compile-module-seq items idx total)
  (if (is-nil items)
      nil
      (let ((r (compile-expr (head items) false)))
        (if (err? r)
            r
            (if (< (+ idx 1) total)
                (do
                  (emit! (list 'op OP-POP)
                         (node-s (head items)) (node-e (head items))
                         (node-exp (head items)))
                  (compile-module-seq (tail items) (+ idx 1) total))
                (compile-module-seq (tail items) (+ idx 1) total))))))

; ---- 字面量（消歧标记形态分派；Bool/Nil 直发指令不进池）----
; 注：标记分派按名字字符串（'true/'false/'nil 在 kerf 中是 bool/nil
; 字面量而非符号——eq 恒假；expander.krf tname 同款纪律）

(define (compile-lit lval s e x)
  (let ((tname (symbol-to-string (head lval))))
    (cond
      ((eq tname "int")
       (emit-push-const (list 'const 'int (second lval)) s e x))
      ((eq tname "float")
       (emit-push-const (list 'const 'float (second lval)) s e x))
      ((eq tname "str")
       (emit-push-const (list 'const 'str (second lval)) s e x))
      ((eq tname "sym")
       (emit-push-const (list 'const 'symlit (second lval)) s e x))
      ((eq tname "true")
       (emit! (list 'op OP-PUSH-TRUE) s e x))
      ((eq tname "false")
       (emit! (list 'op OP-PUSH-FALSE) s e x))
      ((eq tname "nil")
       (emit! (list 'op OP-PUSH-NIL) s e x))
      ((eq tname "pair")
       (compile-lit-pair lval s e x))
      (else
       (cerr "未知字面量标记种类" s e)))))

; 引号点对递归：head 构造 → tail-pos 构造 → MAKE_PAIR（span = 字面量自身）
(define (compile-lit-pair lval s e x)
  (let ((rc (compile-lit-val (second lval) s e x)))
    (if (err? rc)
        rc
        (let ((rd (compile-lit-val (third lval) s e x)))
          (if (err? rd)
              rd
              (emit! (list 'op OP-MAKE-PAIR) s e x))))))

(define (compile-lit-val v s e x)
  (let ((tname (symbol-to-string (head v))))
    (if (eq tname "pair")
        (compile-lit-pair v s e x)
        (compile-lit v s e x))))

(define (emit-push-const cnode s e x)
  (let ((idx (intern-const cnode)))
    (emit! (list 'op OP-PUSH-CONST idx) s e x)))

(define (compile-var namestr scopes s e x)
  (let ((r (resolve-var namestr scopes)))
    (cond
      ((eq (head r) 'local)
       (emit! (list 'op OP-LOAD-LOCAL (second r)) s e x))
      ((eq (head r) 'captured)
       (emit! (list 'op OP-LOAD-CAPTURED (second r)) s e x))
      (else
       (emit! (list 'op OP-LOAD-GLOBAL (intern-global namestr)) s e x)))))

; ===== 入口（镜像 compile_module——每次调用全量复位）=====

; 原型记录 → 输出节点（code/spans 逆序转正）
(define (proto-finish rec)
  (list 'proto
        (first rec)      ; 名形
        (second rec)     ; 参数名
        (third rec)      ; nlocals
        (fourth rec)     ; 捕获名
        (fifth rec)      ; 捕获源
        (reverse (sixth rec))   ; 指令（最终序）
        (reverse (seventh rec)) ; span 三元组（最终序）
        (eighth rec)))   ; 自由变量

; 顶层形式序列：非尾位编译 + 中间值弹出（span = 形式自身）；Halt 终止
(define (compile-toplevel nodes rem)
  (if (is-nil nodes)
      nil
      (let ((r (compile-expr (head nodes) false)))
        (if (err? r)
            r
            (if (> rem 1)
                (do
                  (emit! (list 'op OP-POP)
                         (node-s (head nodes)) (node-e (head nodes))
                         (node-exp (head nodes)))
                  (compile-toplevel (tail nodes) (- rem 1)))
                (compile-toplevel (tail nodes) (- rem 1)))))))

; nodes（core 节点列表）→ ('prog ...) 或 ('err msg s e)
(define (lexc-compile-program nodes)
  (do
    ; 入口复位（确定性纪律——镜像 CompileCtxt::new 每调用新上下文）
    (assign CC-SCOPES (list (cons nil nil)))
    (assign CC-PROTOS nil)
    (assign CC-CUR 0)
    (assign CC-CODE-REV nil)
    (assign CC-SPANS-REV nil)
    (assign CC-CONSTS nil)
    (assign CC-GLOBAL-IDX nil)
    (assign CC-GLOBAL-REFS nil)
    (assign CC-PATCHES nil)
    (assign CC-TRAMPOLINE nil)
    (assign CC-BOUND nil)
    (assign CC-FREE nil)
    (assign CC-CAP-NAMES nil)
    (assign CC-CAP-BINDINGS nil)
    (assign CC-CAP-SRCS nil)
    (assign CC-FREEVARS nil)
    ; main 原型占位（帧 0 + 原型 0；渲染名由桥侧魔法标记重建）
    (assign CC-PROTOS
      (list (list (list 'main) nil 0 nil nil nil nil nil)))
    ; 空程序：PushNil（main_span = 首形式 Span 或哑元 (0 0 0)）
    (if (is-nil nodes)
        (emit! (list 'op OP-PUSH-NIL) 0 0 0)
        nil)
    (let ((main-s (if (is-nil nodes) 0 (node-s (head nodes))))
          (main-e (if (is-nil nodes) 0 (node-e (head nodes))))
          (main-x (if (is-nil nodes) 0 (node-exp (head nodes)))))
      (let ((r (compile-toplevel nodes (length nodes))))
        (if (err? r)
            r
            (do
              (emit! (list 'op OP-HALT) main-s main-e main-x)
              ; 回填完备性断言（§19.3 不变式 2）
              (if (is-nil CC-PATCHES)
                  (do
                    ; main 窗口回写 + 组装输出
                    (proto-set-at! 0
                      (list (list 'main) nil 0 nil nil
                            CC-CODE-REV CC-SPANS-REV nil))
                    (list 'prog
                          (map proto-finish CC-PROTOS)
                          CC-CONSTS
                          CC-GLOBAL-REFS))
                  (cerr "跳转回填不完备（自举编译器内部不变量破坏）"
                        main-s main-e))))))))

; ===== Handle 编译（r25/42-f——镜像 compile_handle 三原型方案）=====
; fields = (tagstr pv pv-scopes rv rv-scopes handler body)
; 确定性序：T 惰性 → H → B → INSTALL_HANDLER 原子发射（捕获由 VM 从
; 当前帧按两原型描述符取——编译器不发射 CLOSURE/CALL，帧编排由指令
; 原子完成；与 Rust compile_handle 逐语义镜像——parity 判据
; bytecode_equal 含 debug_spans，T 的 span 三元组恒 (0 0 0)）
(define (compile-handle fields s e x)
  (let ((tp (ensure-trampoline)))
    (let ((hp (compile-inner-proto
                (list (second fields) (fourth fields))
                (list (third fields) (fifth fields))
                (sixth fields))))
      (if (err? hp)
          hp
          (let ((bp (compile-inner-proto nil nil (seventh fields))))
            (if (err? bp)
                bp
                (let ((tk (intern-const (list 'const 'symlit (first fields)))))
                  (do
                    (emit! (list 'op OP-INSTALL-HANDLER hp bp tk tp) s e x)
                    nil))))))))

; trampoline 惰性生成（程序级单例——首个 Handle 时创建；确定性：同源
; 程序原型序恒一致。code = [RET]，span 三元组 (0 0 0)——哨兵帧的 RET
; 无源位置，与 Rust Span::dummy() 对齐）
(define (ensure-trampoline)
  (if (is-nil CC-TRAMPOLINE)
      (let ((idx (length CC-PROTOS)))
        (do
          (assign CC-PROTOS
            (append CC-PROTOS
              (list (list (list 'anon) nil 0 nil nil
                          (list (list 'op OP-RET))
                          (list (list 0 0 0))
                          nil))))
          (assign CC-TRAMPOLINE idx)
          idx))
      CC-TRAMPOLINE))

; 内层原型构造（compile-fn 的原型段——无 CLOSURE 发射；H/B 原型
; 复用：自由变量分析（bound 起点 = 形参）→ 捕获解析 → 新原型 → 作用域
; 帧压入 → 体编译（tail-pos = true——fn 体语义）→ 尾部 RET（span = 体
; 自身 Span）→ 回写 → 弹帧 → 还原窗口。错误路径直传（入口全量复位
; 约定——同 compile-fn 错误口径）
(define (compile-inner-proto paramstrs paramscopes body)
  (do
    ; 1. 自由变量出现（bound 起点 = 形参——LIFO 形态镜像 Vec 尾）
    (assign CC-BOUND (params->bound paramstrs nil))
    (assign CC-FREE nil)
    (fvo-node body)
    ; 2. 捕获解析（对当前作用域栈——新帧尚未压入）
    (assign CC-CAP-NAMES nil)
    (assign CC-CAP-BINDINGS nil)
    (assign CC-CAP-SRCS nil)
    (assign CC-FREEVARS nil)
    (capture-resolve-loop (reverse CC-FREE))
    (let ((cap-names (reverse CC-CAP-NAMES))
          (cap-binds (reverse CC-CAP-BINDINGS))
          (cap-srcs (reverse CC-CAP-SRCS))
          (freevars (reverse CC-FREEVARS)))
      (let ((proto-idx (length CC-PROTOS)))
        (do
          ; 3. 新原型（捕获描述符随原型冻结；code/spans 空）
          (assign CC-PROTOS
            (append CC-PROTOS
              (list (list (proto-name-form paramstrs)
                          paramstrs
                          (length paramstrs)
                          cap-names cap-srcs nil nil freevars))))
          ; 4. 新作用域帧（形参绑定 + 捕获绑定）
          (assign CC-SCOPES
            (append CC-SCOPES
              (list (cons (param-bindings paramstrs paramscopes)
                          cap-binds))))
          ; 5. 体编译（尾位 = true——fn 体语义；窗口切换）
          (let ((enc-cur CC-CUR)
                (enc-code CC-CODE-REV)
                (enc-spans CC-SPANS-REV))
            (do
              (assign CC-CUR proto-idx)
              (assign CC-CODE-REV nil)
              (assign CC-SPANS-REV nil)
              (let ((r (compile-expr body true)))
                (if (err? r)
                    r
                    (do
                      ; 尾部 RET（span = 体的 Span）
                      (emit! (list 'op OP-RET)
                             (node-s body) (node-e body) (node-exp body))
                      ; 6. 回写新原型 + 弹帧 + 还原窗口
                      (proto-set-at! proto-idx
                        (list (proto-name-form paramstrs)
                              paramstrs
                              (length paramstrs)
                              cap-names cap-srcs
                              CC-CODE-REV CC-SPANS-REV
                              freevars))
                      (assign CC-SCOPES (drop-last CC-SCOPES))
                      (assign CC-CUR enc-cur)
                      (assign CC-CODE-REV enc-code)
                      (assign CC-SPANS-REV enc-spans)
                      proto-idx))))))))))
