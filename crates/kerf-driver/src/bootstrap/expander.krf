; expander.krf — kerf 自举 Expander（Stage 1 批次 E / E1-α：核心形式 + 九糖）
;
; 本文件以 kerf 源码实现展开器子集（9 核心形式 + 9 内置语法糖 + 内部
; define 提升 + TD-004 fresh-scope 作用域注入 + quote datum 转换），
; 在 Stage 0 VM 上运行（07-bootstrap §3.2 混合期构成：Expander 属新
; 语言子集）。行为与种子实现（kerf-expander/*.rs，Rust）对齐——
; CoreExpr（原语形态 + Span(start,end) + 作用域集 + param_scopes）与
; 错误（消息 + Span）的 parity 由 tests/v0/stage1/plan/bootstrap_
; expander_tests.rs 验收（影子路径——生产展开仍走 Rust 种子；
; 宏/define-syntax 属 E1-β）。
;
; 契约（与 kerf-driver/src/bootstrap_expander.rs 桥对接）：
; - 入口 (lexp-expand-program forms)：
;     forms = datum 节点列表（输入格式，见下）
;     正常 → core 节点列表（输出格式，见下）
;     错误 → ('err 消息 起始字节 结束字节)
; - 输入 datum 节点 = (tag s e scopes ...)（tag 为 quote 符号值；
;     s/e = Span 起止字节；scopes = int 列表，桥侧按 ScopeSet 排序去重
;     重建）：
;     ('int s e sc 值) ('float s e sc 值) ('str s e sc 值)
;     ('true s e sc) ('false s e sc) ('nil s e sc)
;     ('sym s e sc 名字str) ('list s e sc 项...) ('vec s e sc 项...)
; - 输出 core 节点 = (tag s e ...)（作用域仅在解析位点显式携带）：
;     ('lit s e 值) ('var s e 名字str scopes)
;     ('app s e 函数 参数...) ('if s e 条件 真分支 假分支)
;     ('lambda s e (名字...) (作用域集列表...) 体)
;     ('set s e 名字str scopes 值) ('define s e 名字str 值)
;     ('begin s e 项...) ('module s e 名字str (导入) (导出) 体...)
;     ('require s e 能力str...)
; - E1-α 边界（显式报错，不静默——§2.3 原则 4）：
;     define-syntax → 「宏展开属 E1-β」错误（parity 语料不含宏）；
;     糖链恒收缩 + 源码嵌套 ≤256 → 展开深度上限 500 不可达（宏经
;     E1-β 一并收口）；宏产物 Span 展开代次（expansion_id）不参与
;     parity 判据（r6 Reader parity 同口径——start/end 逐字一致）。

; ===== 序章：高阶函数（reader.krf 同款）=====

(define (map f lst)
  (if (null? lst)
      nil
      (cons (f (car lst)) (map f (cdr lst)))))

(define (filter pred lst)
  (if (null? lst)
      nil
      (if (pred (car lst))
          (cons (car lst) (filter pred (cdr lst)))
          (filter pred (cdr lst)))))

; ===== 列表与节点访问 =====

(define (second x) (car (cdr x)))
(define (third x) (car (cdr (cdr x))))
(define (fourth x) (car (cdr (cdr (cdr x)))))

; 节点固定字段：tag s e scopes；fields = 其后内容
(define (node-tag n) (car n))
(define (node-s n) (second n))
(define (node-e n) (third n))
(define (node-scopes n) (fourth n))
(define (node-fields n) (cdr (cdr (cdr (cdr n)))))
; 字段访问：cdr 步进（算术索引不经 int 参数内置——保守类型检查的
; num 联合边界，与种子行为等价：list-ref n (+ 4 i)）
(define (drop-k lst k)
  (if (= k 0)
      lst
      (drop-k (cdr lst) (- k 1))))
(define (node-field n i) (car (drop-k n (+ 4 i))))
(define (node-count n) (+ 1 (length (node-fields n))))
(define (sym-name n) (node-field n 0))

; 形式项（含头）的尾区：items[1..]（糖实参区）与 items[2..]（体区）
(define (form-args items) (cdr items))
(define (form-body items) (cdr (cdr items)))

; 头部符号名（列表节点首项为 sym 时）；否则 nil
(define (head-name node)
  (let ((items (node-fields node)))
    (if (null? items)
        nil
        (let ((h (car items)))
          (if (eq? (node-tag h) 'sym)
              (sym-name h)
              nil)))))

; ===== 作用域集（int 列表——桥侧排序去重重建 ScopeSet）=====

(define SCOPE-NEXT 1)

(define (fresh-scope)
  (let ((s SCOPE-NEXT))
    (begin (set! SCOPE-NEXT (+ SCOPE-NEXT 1)) s)))

; 深注入（镜像 Stx::add_scope_to_all）：重建节点树，每节点作用域并入 s
(define (inject-scope node s)
  (cons (node-tag node)
        (cons (node-s node)
              (cons (node-e node)
                    (cons (cons s (node-scopes node))
                          (inject-children (node-tag node)
                                           (node-fields node)
                                           s))))))

(define (inject-children tag fields s)
  (if (or (eq? tag 'list) (eq? tag 'vec))
      (map (lambda (c) (inject-scope c s)) fields)
      fields))

; 重打作用域标签（镜像 macro_sys::retag_scopes 替换语义——糖产物全节点
; 作用域统一为 use-site；Span 展开代次见文件头 E1-α 边界注记）
(define (retag-scope node scopes)
  (cons (node-tag node)
        (cons (node-s node)
              (cons (node-e node)
                    (cons scopes
                          (retag-children (node-tag node)
                                          (node-fields node)
                                          scopes))))))

(define (retag-children tag fields scopes)
  (if (or (eq? tag 'list) (eq? tag 'vec))
      (map (lambda (c) (retag-scope c scopes)) fields)
      fields))

; ===== 关键字/糖表（字符串口径——与种子 intern 同名同 Symbol）=====

(define KEYWORDS
  (list "lambda" "if" "set!" "define" "begin" "module" "import" "export"
        "quote" "let" "letrec" "let*" "cond" "else" "and" "or" "when"
        "while" "unless" "define-syntax" "syntax-rules" "require"))

(define SUGAR-HEADS
  (list "let" "letrec" "let*" "cond" "and" "or" "when" "unless" "while"))

(define (is-keyword? name) (not (bool? (member name KEYWORDS))))
(define (is-sugar-head? name) (not (bool? (member name SUGAR-HEADS))))

; ===== 错误与节点构造 =====

; 结果 err 判定：('err msg s e)；core 节点 tag 集不含 'err，无歧义
(define (err? v) (and (pair? v) (eq? (car v) 'err)))
(define (xperr msg s e) (list 'err msg s e))

(define (make-node tag s e scopes fields)
  (cons tag (cons s (cons e (cons scopes fields)))))

(define (sym-node s e name) (make-node 'sym s e nil (list name)))
; 注意：true/false/nil 在 kerf 源码中是字面量（Bool/Nil）而非符号——
; 节点 tag 需 Symbol，经 string->symbol 铸造（与桥侧 tag("true") 同名）
(define NIL-TAG (string->symbol "nil"))
(define TRUE-TAG (string->symbol "true"))
(define FALSE-TAG (string->symbol "false"))
(define (nil-node s e) (make-node NIL-TAG s e nil nil))
(define (true-node s e) (make-node TRUE-TAG s e nil nil))
(define (false-node s e) (make-node FALSE-TAG s e nil nil))

; 糖引入标识符唯一化名（镜像 HygieneCtx：每次糖实例化计数从 0 起 →
; fresh_symbol 恒为 1 号 → loop$hyg$1；词法遮蔽保证多次 while 不串扰）
(define LOOP-NAME "loop$hyg$1")

; ===== 二元绑定组解析（let/letrec 共用）=====
; → (名字sym节点列表 . 值节点列表) 或 ('err ...)

(define (bind-pairs bindings msg-group msg-pair msg-name)
  (if (null? bindings)
      (cons nil nil)
      (let ((b (car bindings)))
        (if (not (eq? (node-tag b) 'list))
            (xperr msg-pair (node-s b) (node-e b))
            (let ((fs (node-fields b)))
              (if (not (= (length fs) 2))
                  (xperr msg-pair (node-s b) (node-e b))
                  (let ((nm (car fs)))
                    (if (not (eq? (node-tag nm) 'sym))
                        (xperr msg-name (node-s nm) (node-e nm))
                        (let ((rest (bind-pairs (cdr bindings) msg-group
                                                msg-pair msg-name)))
                          (if (err? rest)
                              rest
                              (cons (cons nm (car rest))
                                    (cons (second fs) (cdr rest)))))))))))))

; ===== 内置语法糖（镜像 sugar.rs——span/消息逐字一致；
; 构造节点作用域经 retag 统一为 use-site，内部选择不参与输出）=====

; (let ((x e)...) body...) → ((lambda (x...) body...) e...)
(define (desugar-let args)
  (if (< (length args) 2)
      (xperr "let 形式：(let ((名 值)...) 体...)" 0 0)
      (let ((bindg (car args)))
        (if (not (eq? (node-tag bindg) 'list))
            (xperr "let 绑定组必须是列表" (node-s bindg) (node-e bindg))
            (let ((r (bind-pairs (node-fields bindg) "let"
                                 "let 绑定必须是 (名 值) 二元列表"
                                 "let 绑定名必须是符号")))
              (if (err? r)
                  r
                  (let ((names (car r)) (values (cdr r)))
                    (let ((s (node-s bindg)) (e (node-e bindg)))
                      (make-node 'list s e nil
                        (cons (make-node 'list s e nil
                                 (cons (sym-node s e "lambda")
                                       (cons (make-node 'list s e nil names)
                                             (form-args args))))
                              values))))))))))

; letrec 的 set! 形式列表（镜像：set! 节点 span = pair[0].span，
; 头符号 span = 绑定组 span）
(define (letrec-sets bindings span-s span-e)
  (if (null? bindings)
      nil
      (let ((b (car bindings)))
        (let ((fs (node-fields b)))
          (let ((nm (car fs)) (val (second fs)))
            (let ((r (letrec-sets (cdr bindings) span-s span-e)))
              (if (err? r)
                  r
                  (cons (make-node 'list (node-s nm) (node-e nm) nil
                           (list (sym-node span-s span-e "set!")
                                 (sym-node (node-s nm) (node-e nm) (sym-name nm))
                                 val))
                        r))))))))

; (letrec ((f e)...) body...) → ((lambda (f...) (begin (set! f e)... body...)) nil...)
(define (desugar-letrec args)
  (if (< (length args) 2)
      (xperr "letrec 形式：(letrec ((名 值)...) 体...)" 0 0)
      (let ((bindg (car args)))
        (if (not (eq? (node-tag bindg) 'list))
            (xperr "letrec 绑定组必须是列表" (node-s bindg) (node-e bindg))
            (let ((r (bind-pairs (node-fields bindg) "letrec"
                                 "letrec 绑定必须是 (名 值) 二元列表"
                                 "letrec 绑定名必须是符号")))
              (if (err? r)
                  r
                  (let ((names (car r)))
                    (let ((s (node-s bindg)) (e (node-e bindg)))
                      (let ((sets (letrec-sets (node-fields bindg) s e)))
                        (if (err? sets)
                            sets
                            (let ((begin-node
                                    (make-node 'list s e nil
                                      (cons (sym-node s e "begin")
                                            (append sets (form-args args))))))
                              (make-node 'list s e nil
                                (cons (make-node 'list s e nil
                                         (cons (sym-node s e "lambda")
                                               (cons (make-node 'list s e nil
                                                        (map (lambda (n)
                                                               (sym-node s e (sym-name n)))
                                                             names))
                                                     (list begin-node))))
                                      (map (lambda (n) (nil-node s e)) names))))))))))))))

; (let* ((x e) rest...) body...) → (let ((x e)) (let* (rest...) body...))
; (let* () body...) → (let () body...)
(define (desugar-let* args)
  (if (< (length args) 2)
      (xperr "let* 形式：(let* ((名 值)...) 体...)" 0 0)
      (let ((bindg (car args)))
        (if (not (eq? (node-tag bindg) 'list))
            (xperr "let* 绑定组必须是列表" (node-s bindg) (node-e bindg))
            (let ((bindings (node-fields bindg)))
              (if (null? bindings)
                  (desugar-let args)
                  (let ((s (node-s bindg)) (e (node-e bindg)))
                    (make-node 'list s e nil
                      (list (sym-node s e "let")
                            (make-node 'list s e nil (list (car bindings)))
                            (make-node 'list s e nil
                              (cons (sym-node s e "let*")
                                    (cons (make-node 'list s e nil (cdr bindings))
                                          (form-args args)))))))))))))

; (cond (c1 e1)...) → 嵌套 if（右向左构造；(test) → test；(else body...) → body）
(define (desugar-cond args)
  (if (null? args)
      (xperr "cond 需要至少一个子句" 0 0)
      (cond-chain (reverse args) nil)))

(define (cond-chain rev-clauses chain)
  (if (null? rev-clauses)
      chain
      (let ((clause (car rev-clauses)))
        (if (or (not (eq? (node-tag clause) 'list))
                (null? (node-fields clause)))
            (xperr "cond 子句必须是非空列表" (node-s clause) (node-e clause))
            (let ((test (car (node-fields clause))))
              (let ((is-else (and (eq? (node-tag test) 'sym)
                                  (eq? (sym-name test) "else"))))
                (let ((body (cond-body (node-fields clause))))
                  (if (err? body)
                      body
                      (let ((node
                              (if is-else
                                  body
                                  (make-node 'list (node-s test) (node-e test) nil
                                    (cons (sym-node (node-s test) (node-e test) "if")
                                          (cons test
                                                (cons body
                                                      (list (if (null? chain)
                                                                (nil-node (node-s test)
                                                                          (node-e test))
                                                                chain)))))))))
                        (cond-chain (cdr rev-clauses) node))))))))))

(define (cond-body fs)
  (let ((test (car fs)))
    (if (= (length fs) 1)
        test
        (if (= (length fs) 2)
            (second fs)
            (make-node 'list (node-s test) (node-e test) nil
              (cons (sym-node (node-s test) (node-e test) "begin")
                    (cdr fs)))))))

; (and) → true；(and a) → a；(and a b...) → (if a (and b...) false)
; (or) → false；(or a) → a；(or a b...) → (if a true (or b...))
(define (desugar-and args)
  (desugar-and-or args true false))

(define (desugar-or args)
  (desugar-and-or args false true))

(define (desugar-and-or args unit other)
  (if (null? args)
      (if (eq? unit true) (true-node 0 0) (false-node 0 0))
      (if (null? (cdr args))
          (car args)
          (let ((s (node-s (car args))) (e (node-e (car args))))
            (let ((rest (desugar-and-or (cdr args) unit other)))
              (if (eq? unit true)
                  (make-node 'list s e nil
                    (list (sym-node s e "if") (car args) rest (false-node s e)))
                  (make-node 'list s e nil
                    (list (sym-node s e "if") (car args) (true-node s e) rest))))))))

; (when c body...) → (if c (begin body...) nil)
(define (desugar-when args)
  (if (null? args)
      (xperr "when 形式：(when 条件 体...)" 0 0)
      (when-unless args true)))

; (unless c body...) → (if c nil (begin body...))
(define (desugar-unless args)
  (if (null? args)
      (xperr "unless 形式：(unless 条件 体...)" 0 0)
      (when-unless args false)))

(define (when-unless args when-true)
  (let ((s (node-s (car args))) (e (node-e (car args))))
    (let ((body (make-node 'list s e nil
                  (cons (sym-node s e "begin") (form-args args)))))
      (if (eq? when-true true)
          (make-node 'list s e nil
            (list (sym-node s e "if") (car args) body (nil-node s e)))
          (make-node 'list s e nil
            (list (sym-node s e "if") (car args) (nil-node s e) body))))))

; (while c body...) → (letrec ((loop (lambda () (if c (begin body... (loop)) nil)))) (loop))
(define (desugar-while args)
  (if (null? args)
      (xperr "while 形式：(while 条件 体...)" 0 0)
      (let ((s (node-s (car args))) (e (node-e (car args))))
        (let ((loop-call (make-node 'list s e nil (list (sym-node s e LOOP-NAME)))))
          (let ((body (make-node 'list s e nil
                        (cons (sym-node s e "begin")
                              (append (form-args args) (list loop-call))))))
            (let ((if-form (make-node 'list s e nil
                              (list (sym-node s e "if") (car args) body
                                    (nil-node s e)))))
              (let ((lambda-node (make-node 'list s e nil
                                  (list (sym-node s e "lambda")
                                        (make-node 'list s e nil nil)
                                        if-form))))
                (let ((binding (make-node 'list s e nil
                                (list (make-node 'list s e nil
                                        (list (sym-node s e LOOP-NAME)
                                              lambda-node))))))
                  (make-node 'list s e nil
                    (list (sym-node s e "letrec") binding loop-call))))))))))

; ===== quote datum → 值（镜像 core_forms::datum_to_value）=====

(define (datum->value node)
  (let ((tag (node-tag node)))
    (let ((tname (symbol->string tag)))
      (cond ((eq? tname "int") (node-field node 0))
          ((eq? tname "float") (node-field node 0))
          ((eq? tname "str") (node-field node 0))
          ((eq? tname "true") true)
          ((eq? tname "false") false)
          ((eq? tname "nil") nil)
          ((eq? tname "sym") (string->symbol (strip-hyg (sym-name node))))
          ((eq? tname "list") (list->pairs (reverse (node-fields node)) nil))
          ((eq? tname "vec")
           (xperr "quote 向量暂不支持（Vector 值类型推迟，后续阶段）"
                  (node-s node) (node-e node)))
          (else (xperr (str-append "未知 datum 节点[datum]:" tname)
                       (node-s node) (node-e node)))))))

; 列表右折叠为序对链（镜像：acc 从 Nil 起，reverse 后逐项 cons）
(define (list->pairs rev-items acc)
  (if (null? rev-items)
      acc
      (let ((v (datum->value (car rev-items))))
        (if (err? v)
            v
            (list->pairs (cdr rev-items) (cons v acc))))))

; $hyg$ 后缀剥离（镜像 strip_hygiene_suffix：rsplit_once 语义——取
; 最后一次出现前缀，无则原样；无数字校验（与 core_forms 口径一致）。
; 经字符表模式匹配实现（算术索引不经 int 参数内置——保守类型检查
; 的 num 联合边界））
(define (fifth x) (car (cdr (cdr (cdr (cdr x))))))

(define (str-chars s) (map cdr (str->pos-chars s)))

(define HYG-CHARS (list "$" "h" "y" "g" "$"))

(define (starts-hyg? chars)
  (and (pair? chars) (eq? (car chars) "$")
       (pair? (cdr chars)) (eq? (second chars) "h")
       (pair? (cdr (cdr chars))) (eq? (third chars) "y")
       (pair? (cdr (cdr (cdr chars)))) (eq? (fourth chars) "g")
       (pair? (cdr (cdr (cdr (cdr chars))))) (eq? (fifth chars) "$")))

(define (drop-hyg chars) (cdr (cdr (cdr (cdr (cdr chars))))))

; → (前缀 . 余部（已消耗首个 $hyg$）) 或 nil（无 $hyg$）
(define (find-first-hyg chars)
  (find-first-hyg-loop chars nil))

(define (find-first-hyg-loop chars acc)
  (cond ((null? chars) nil)
        ((starts-hyg? chars) (cons (reverse acc) (drop-hyg chars)))
        (else (find-first-hyg-loop (cdr chars) (cons (car chars) acc)))))

; → (最后前缀 . 尾部) 或 nil（rsplit 语义）
(define (find-last-hyg chars)
  (let ((first (find-first-hyg chars)))
    (if (null? first)
        nil
        (let ((next (find-last-hyg (cdr first))))
          (if (null? next)
              (cons (car first) (cdr first))
              (cons (append (append (car first) HYG-CHARS) (car next))
                    (cdr next)))))))

(define (chars->str chars) (foldl str-append "" chars))

(define (strip-hyg name)
  (let ((r (find-last-hyg (str-chars name))))
    (if (null? r)
        name
        (chars->str (car r)))))

; ===== 核心形式展开（镜像 core_forms.rs）=====

(define (expand-core-form kw-name node)
  (let ((items (node-fields node))
        (s (node-s node)) (e (node-e node)))
    (cond
      ((eq? kw-name "lambda") (expand-lambda node))
      ((eq? kw-name "if")
       (if (and (not (= (length items) 3)) (not (= (length items) 4)))
           (xperr "if 形式：(if 条件 真分支 [假分支])" s e)
           (let ((c (expand-form (second items))))
             (if (err? c)
                 c
                 (let ((t (expand-form (third items))))
                   (if (err? t)
                       t
                       (let ((el (if (= (length items) 4)
                                     (expand-form (fourth items))
                                     (list 'lit s e nil))))
                         (if (err? el) el (list 'if s e c t el)))))))))
      ((eq? kw-name "set!")
       (if (not (= (length items) 3))
           (xperr "set! 形式：(set! 名 值)" s e)
           (let ((target (second items)))
             (if (not (eq? (node-tag target) 'sym))
                 (xperr "set! 目标必须是符号" (node-s target) (node-e target))
                 (let ((v (expand-form (third items))))
                   (if (err? v)
                       v
                       (list 'set s e (sym-name target)
                             (node-scopes target) v)))))))
      ((eq? kw-name "define") (expand-define node))
      ((eq? kw-name "begin")
       (let ((r (expand-seq (form-args items))))
         (if (err? r) r (cons 'begin (cons s (cons e r))))))
      ((eq? kw-name "module") (expand-module node))
      ((eq? kw-name "quote")
       (if (not (= (length items) 2))
           (xperr "quote 形式：(quote 数据)" s e)
           (let ((v (datum->value (second items))))
             (if (err? v) v (list 'lit s e v)))))
      ((eq? kw-name "require") (expand-require node))
      ((or (eq? kw-name "import") (eq? kw-name "export"))
       (xperr "import/export 只能出现在 module 形式内部" s e))
      ((or (eq? kw-name "let") (eq? kw-name "letrec") (eq? kw-name "let*")
           (eq? kw-name "cond") (eq? kw-name "and") (eq? kw-name "or")
           (eq? kw-name "when") (eq? kw-name "unless") (eq? kw-name "while"))
       (xperr "语法糖形式应经内置变换器处理（内部不变式破坏）" s e))
      ((eq? kw-name "else")
       (xperr "else 只能出现在 cond 子句的测试位置" s e))
      ((eq? kw-name "define-syntax")
       (xperr "define-syntax 暂不经自举 Expander（E1-α 边界——宏展开经 E1-β 收口）" s e))
      ((eq? kw-name "syntax-rules")
       (xperr "syntax-rules 只能出现在 define-syntax 内部" s e))
      (else (xperr "未知关键字" s e)))))

; (lambda (参数...) 体...)——fresh scope 深注入（TD-004 镜像）
(define (expand-lambda node)
  (let ((items (node-fields node))
        (s (node-s node)) (e (node-e node)))
    (if (< (length items) 3)
        (xperr "lambda 形式：(lambda (参数...) 体...)" s e)
        (let ((fresh (fresh-scope)))
          (let ((param-stx (inject-scope (second items) fresh))
                (body-forms (map (lambda (f) (inject-scope f fresh))
                                 (form-body items))))
            (let ((params (parse-params param-stx)))
              (if (err? params)
                  params
                  (let ((body (expand-body body-forms)))
                    (if (err? body)
                        body
                        (list 'lambda s e
                              (map sym-name params)
                              (map node-scopes params)
                              body))))))))))

; 参数表 → sym 节点列表；重复名按已收集集报错（镜像 params.contains——
; 错误 Span = 第二次出现处）
(define (parse-params param-stx)
  (if (not (eq? (node-tag param-stx) 'list))
      (xperr "lambda 参数必须是符号列表"
             (node-s param-stx) (node-e param-stx))
      (parse-param-items (node-fields param-stx) nil)))

(define (parse-param-items items collected)
  (if (null? items)
      (reverse collected)
      (let ((p (car items)))
        (if (not (eq? (node-tag p) 'sym))
            (xperr "lambda 参数必须是符号（不支持解构参数）"
                   (node-s p) (node-e p))
            (if (not (null? (filter (lambda (q) (eq? (sym-name q) (sym-name p)))
                                    collected)))
                (xperr "lambda 参数重名（同名形参只允许出现一次）"
                       (node-s p) (node-e p))
                (parse-param-items (cdr items) (cons p collected)))))))

; 函数体展开：内部 define 提升（镜像 expand_body——构造节点作用域 ∅，
; 提升产物经 expand-form 再展开无 retag；define 名校验随切分逐个执行
; （镜像 split 循环中的 define_name 调用序））
(define (expand-body forms)
  (let ((split (split-head-defines forms)))
    (if (err? split)
        split
        (let ((defines (car split)) (rest (cdr split)))
          (let ((late (first-late-define rest)))
            (if (null? late)
                (if (null? defines)
                    (let ((exprs (expand-seq forms)))
                      (if (err? exprs)
                          exprs
                          (wrap-body exprs forms)))
                    (expand-body-hoist defines rest forms))
                (xperr "define 必须位于函数体头部（后续 define 不合法）"
                       (node-s late) (node-e late))))))))

; 头部 define 切分：(前导 define 节点列表 . 余形式列表)；每个前导
; define 的名字随切分校验（镜像 define_name 调用序——先名校验后值校验）
(define (split-head-defines forms)
  (if (null? forms)
      (cons nil nil)
      (if (is-define-head? (car forms))
          (let ((nm (define-name (car forms))))
            (if (err? nm)
                nm
                (let ((r (split-head-defines (cdr forms))))
                  (if (err? r)
                      r
                      (cons (cons (car forms) (car r)) (cdr r))))))
          (cons nil forms))))

; 余形式中首个 define 头形式（无 → nil）
(define (first-late-define forms)
  (if (null? forms)
      nil
      (if (is-define-head? (car forms))
          (car forms)
          (first-late-define (cdr forms)))))

(define (is-define-head? node)
  (if (not (eq? (node-tag node) 'list))
      false
      (let ((h (head-name node)))
        (if (null? h)
            false
            (eq? h "define")))))

(define (wrap-body exprs forms)
  (if (null? (cdr exprs))
      (car exprs)
      (cons 'begin (cons (node-s (car forms)) (cons (node-e (car forms)) exprs)))))

; 提升主体：((lambda (名...) (begin (set! 名 值)... 体...)) nil...)
; 值形式逐个校验并构造（镜像 hoist 循环的错误短路序）
(define (expand-body-hoist defines rest forms)
  (let ((span-form (car forms))
        (names (map define-name defines))
        (set-forms (make-setbangs defines)))
    (if (err? set-forms)
        set-forms
        (let ((s (node-s span-form)) (e (node-e span-form)))
          (let ((body-forms (append set-forms rest)))
            (let ((lambda-node
                    (make-node 'list s e nil
                      (cons (sym-node 0 0 "lambda")
                            (cons (make-node 'list s e nil
                                     (map (lambda (n) (sym-node s e n)) names))
                                  body-forms)))))
              (let ((app-node
                      (make-node 'list s e nil
                        (cons lambda-node
                              (map (lambda (n) (nil-node s e)) names)))))
                (expand-form app-node))))))))

; 逐 define：先值校验/构造，再 set! 形式（错误短路）
(define (make-setbangs defines)
  (if (null? defines)
      nil
      (let ((v (define-value (car defines))))
        (if (err? v)
            v
            (let ((r (make-setbangs (cdr defines))))
              (if (err? r)
                  r
                  (cons (make-setbang-with (car defines) v) r)))))))

; (set! 名 值) 形式（镜像 make_setbang——全部字段 span = define 节点
; span，作用域 ∅；值预先校验）
(define (make-setbang-with def value)
  (make-node 'list (node-s def) (node-e def) nil
    (list (sym-node (node-s def) (node-e def) "set!")
          (sym-node (node-s def) (node-e def) (define-name def))
          value)))

; define 名字（镜像 define_name 校验：不完整/函数糖首元素/非符号）
(define (define-name def)
  (let ((items (node-fields def)))
    (if (< (length items) 2)
        (xperr "define 形式不完整" (node-s def) (node-e def))
        (let ((target (second items)))
          (if (eq? (node-tag target) 'list)
              (if (or (null? (node-fields target))
                      (not (eq? (node-tag (car (node-fields target))) 'sym)))
                  (xperr "define 函数糖首元素必须是符号"
                         (node-s target) (node-e target))
                  (sym-name (car (node-fields target))))
              (if (not (eq? (node-tag target) 'sym))
                  (xperr "define 目标必须是符号"
                         (node-s target) (node-e target))
                  (sym-name target)))))))

; define 值形式（镜像 define_value_stx：函数糖 → lambda 形式（参数表/
; lambda 节点 span = items[1].span）；非函数糖须恰好 3 元，否则短消息
; 报错（提升路径口径——与 expand_define 的长消息区分））
(define (define-value def)
  (let ((items (node-fields def)))
    (let ((target (second items)))
      (if (eq? (node-tag target) 'list)
          (let ((s (node-s target)) (e (node-e target)))
            (make-node 'list s e nil
              (cons (sym-node 0 0 "lambda")
                    (cons (make-node 'list s e nil (cdr (node-fields target)))
                          (form-body items)))))
          (if (not (= (length items) 3))
              (xperr "define 值形式必须是单个表达式"
                     (node-s def) (node-e def))
              (third items))))))

; (define 名 值) / (define (名 参数...) 体...)——镜像 expand_define
; （函数糖路径：参数表/lambda 节点 span = define 整体 span）
(define (expand-define node)
  (let ((items (node-fields node))
        (s (node-s node)) (e (node-e node)))
    (if (< (length items) 3)
        (xperr "define 形式：(define 名 值) 或 (define (名 参数...) 体...)" s e)
        (let ((target (second items)))
          (if (eq? (node-tag target) 'list)
              (let ((flist (node-fields target)))
                (if (or (null? flist) (not (eq? (node-tag (car flist)) 'sym)))
                    (xperr "define 函数糖首元素必须是符号"
                           (node-s target) (node-e target))
                    (let ((fname (sym-name (car flist))))
                      (let ((lambda-node
                              (make-node 'list s e nil
                                (cons (sym-node 0 0 "lambda")
                                      (cons (make-node 'list s e nil
                                               (cdr flist))
                                            (form-body items))))))
                        (expand-form
                          (make-node 'list s e nil
                            (list (sym-node 0 0 "define")
                                  (sym-node (node-s target) (node-e target) fname)
                                  lambda-node)))))))
              (if (not (eq? (node-tag target) 'sym))
                  (xperr "define 目标必须是符号" (node-s target) (node-e target))
                  (if (not (= (length items) 3))
                      (xperr
                        "define 值形式必须是单个表达式（函数糖请用 (define (名 参数...) 体...)）"
                        s e)
                      (let ((v (expand-form (third items))))
                        (if (err? v)
                            v
                            (list 'define s e (sym-name target) v))))))))))

; (module 名 [(import ...)] [(export ...)] 体...)——镜像 expand_module
(define (expand-module node)
  (let ((items (node-fields node))
        (s (node-s node)) (e (node-e node)))
    (if (< (length items) 2)
        (xperr "module 形式：(module 名 [(import ...)] [(export ...)] 体...)" s e)
        (let ((name-node (second items)))
          (if (not (eq? (node-tag name-node) 'sym))
              (xperr "module 名必须是符号" (node-s name-node) (node-e name-node))
              (let ((r (module-header items 2)))
                (if (err? r)
                    r
                    (let ((imports (car r)) (exports (second r))
                          (body-start (third r)))
                      (let ((body (expand-seq (list-tail items body-start))))
                        (if (err? body)
                            body
                            (cons 'module
                                  (cons s
                                        (cons e
                                              (cons (sym-name name-node)
                                                    (cons imports
                                                          (cons exports body))))))))))))))))

; 头部 import/export 解析 → (导入列表 导出列表 体起始序号)
(define (module-header items idx)
  (if (>= idx (length items))
      (list nil nil idx)
      (let ((item (list-ref items idx)))
        (if (not (eq? (node-tag item) 'list))
            (list nil nil idx)
            (let ((h (head-name item)))
              (cond ((eq? h "import")
                     (let ((r (module-names (form-args (node-fields item))
                                            "import")))
                       (if (err? r)
                           r
                           (let ((rest (module-header items (+ idx 1))))
                             (if (err? rest)
                                 rest
                                 (list r (second rest) (third rest)))))))
                    ((eq? h "export")
                     (let ((r (module-names (form-args (node-fields item))
                                            "export")))
                       (if (err? r)
                           r
                           (let ((rest (module-header items (+ idx 1))))
                             (if (err? rest)
                                 rest
                                 (list (car rest) r (third rest)))))))
                    (else (list nil nil idx))))))))

(define (module-names fields kind)
  (if (null? fields)
      nil
      (let ((item (car fields)))
        (if (not (eq? (node-tag item) 'sym))
            (xperr (str-append kind " 项必须是符号")
                   (node-s item) (node-e item))
            (let ((r (module-names (cdr fields) kind)))
              (if (err? r)
                  r
                  (cons (sym-name item) r)))))))

; (require io read|write ...)——镜像 expand_require
(define (expand-require node)
  (let ((items (node-fields node))
        (s (node-s node)) (e (node-e node)))
    (if (< (length items) 3)
        (xperr "require 形式：(require io read|write)——主体与能力项不可缺省" s e)
        (let ((subj (second items)))
          (if (not (eq? (node-tag subj) 'sym))
              (xperr "require 主体必须是符号（当前仅 io）"
                     (node-s subj) (node-e subj))
              (if (not (eq? (sym-name subj) "io"))
                  (xperr (str-append
                           (str-append "未知能力主体「" (sym-name subj))
                           "」（当前仅支持 io；net/process 属 Stage 2）")
                         (node-s subj) (node-e subj))
                  (let ((caps (require-caps (form-body items) nil)))
                    (if (err? caps)
                        caps
                        (cons 'require (cons s (cons e caps)))))))))))

(define (require-caps cap-nodes acc)
  (if (null? cap-nodes)
      acc
      (let ((item (car cap-nodes)))
        (if (not (eq? (node-tag item) 'sym))
            (xperr "require 能力项必须是符号（read/write）"
                   (node-s item) (node-e item))
            (let ((name (sym-name item)))
              (if (and (not (eq? name "read")) (not (eq? name "write")))
                  (xperr (str-append
                           (str-append "未知能力项「" name)
                           "」（当前仅 read/write）")
                         (node-s item) (node-e item))
                  (if (not (null? (filter (lambda (c) (eq? c name)) acc)))
                      (require-caps (cdr cap-nodes) acc)
                      (require-caps (cdr cap-nodes)
                                    (append acc (list name))))))))))

; ===== 展开主控（trampoline + 分派——镜像 expand_form/expand_list）=====

; 序列展开（左到右短路）
(define (expand-seq forms)
  (if (null? forms)
      nil
      (let ((f (expand-form (car forms))))
        (if (err? f)
            f
            (let ((r (expand-seq (cdr forms))))
              (if (err? r) r (cons f r)))))))

(define (expand-form node)
  (let ((tag (node-tag node)))
    (if (eq? tag 'list)
        (expand-list-trampoline node)
        (expand-form-leaf node))))

; 叶子分派（字面量/符号/向量——镜像 expand_form 的 match 直达分支）
(define (expand-form-leaf node)
  (let ((tag (node-tag node)))
    (let ((tname (symbol->string tag)))
      (cond
      ((eq? tname "int") (list 'lit (node-s node) (node-e node) (node-field node 0)))
      ((eq? tname "float") (list 'lit (node-s node) (node-e node) (node-field node 0)))
      ((eq? tname "str") (list 'lit (node-s node) (node-e node) (node-field node 0)))
      ((eq? tname "true") (list 'lit (node-s node) (node-e node) true))
      ((eq? tname "false") (list 'lit (node-s node) (node-e node) false))
      ((eq? tname "nil") (list 'lit (node-s node) (node-e node) nil))
      ((eq? tname "sym")
       (list 'var (node-s node) (node-e node) (sym-name node)
             (node-scopes node)))
      ((eq? tname "vec")
       (xperr "向量不能出现在表达式位置（仅用于绑定组/模式）"
              (node-s node) (node-e node)))
      (else (xperr (str-append "未知 datum 节点[leaf]:" tname)
                   (node-s node) (node-e node)))))))

; trampoline：糖头循环展开（产物可能是任意节点——经 expand-form 全
; 分派再入，镜像 expand_form 的 while + match 结构）
(define (expand-list-trampoline node)
  (let ((name (head-name node)))
    (if (and (not (null? name)) (is-sugar-head? name))
        (let ((product (desugar-dispatch name (form-args (node-fields node)))))
          (if (err? product)
              (xperr (str-append
                       (str-append "宏「" name)
                       (str-append "」展开失败：" (second product)))
                     (node-s node) (node-e node))
              (expand-form
                (retag-scope product (node-scopes node)))))
        (expand-list-final node))))

(define (desugar-dispatch name args)
  (cond ((eq? name "let") (desugar-let args))
        ((eq? name "letrec") (desugar-letrec args))
        ((eq? name "let*") (desugar-let* args))
        ((eq? name "cond") (desugar-cond args))
        ((eq? name "and") (desugar-and args))
        ((eq? name "or") (desugar-or args))
        ((eq? name "when") (desugar-when args))
        ((eq? name "unless") (desugar-unless args))
        ((eq? name "while") (desugar-while args))
        (else (xperr "未知糖形式" 0 0))))

; trampoline 收敛后：核心形式或函数应用（函数先求值，参数从左到右）
(define (expand-list-final node)
  (let ((items (node-fields node))
        (s (node-s node)) (e (node-e node)))
    (if (null? items)
        (xperr "空列表不能作为表达式求值" s e)
        (let ((name (head-name node)))
          (if (and (not (null? name)) (is-keyword? name))
              (expand-core-form name node)
              (let ((fn-core (expand-form (car items))))
                (if (err? fn-core)
                    fn-core
                    (let ((args (expand-seq (form-args items))))
                      (if (err? args)
                          args
                          (cons 'app (cons s (cons e (cons fn-core args)))))))))))))

; ===== 入口 =====

; forms（datum 节点列表）→ core 节点列表 或 ('err msg s e)
(define (lexp-expand-program forms)
  (set! SCOPE-NEXT 1)
  (expand-seq forms))
